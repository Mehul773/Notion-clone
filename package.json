{
  "name": "slate",
  "productName": "Slate",
  "version": "1.0.0",
  "description": "A Notion-style workspace for pages, databases, and notes.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n convex,vite,electron -c cyan,magenta,yellow \"npm:dev:convex\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:convex": "convex dev",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "tsc -b && vite build",
    "seed": "node scripts/seed-backend.mjs",
    "predist": "node scripts/seed-backend.mjs",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.slate.app",
    "productName": "Slate",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/backend/**"
    ],
    "extraResources": [
      {
        "from": "electron/backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Slate"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@emoji-mart/data": "^1.2.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "convex": "^1.41.0",
    "driver.js": "^1.4.0",
    "expr-eval": "^2.0.2",
    "lucide-react": "^1.17.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
